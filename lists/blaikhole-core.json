{
  "name": "Blaikhole Core",
  "version": "0.2.1",
  "updated": "2026-11-21",
  "license": "CC-BY-4.0",
  "homepage": "https://github.com/Evening-Star-System/blaikhole",
  "note": "Source-level redirects (Google udm=14, DuckDuckGo assist=false+kbe=0, Brave summary=0, Qwant llm=0) are the most durable blocks but are vendor-undocumented and may change; re-check periodically. css and contains selectors are starter/sourced and must be verified against each live site (use scripts/capture-selector.js). Prefer durable anchors (aria-label, role, stable data-*, custom-element tags) over class names, which churn.",
  "lists": [
    {
      "id": "google-ai",
      "name": "Google AI Overviews and AI Mode",
      "recommended": true,
      "match": ["google."],
      "redirect": [
        { "path": "/search", "param": "udm", "value": "14" }
      ],
      "css": [
        "div[data-subtree='aiov']",
        "div[aria-label='AI Overview']",
        "block-component:has([aria-label='AI Overview'])"
      ],
      "contains": [
        { "text": "ai overview", "scope": "h1,h2,h3,[role='heading'],div[aria-label]", "up": 4, "maxlen": 24 }
      ]
    },
    {
      "id": "ai-assistants",
      "name": "AI assistant panels (Copilot, Gemini, Meta AI, Grok)",
      "recommended": true,
      "match": ["bing.com", "microsoft.com", "github.com", "facebook.com", "instagram.com", "x.com", "twitter.com"],
      "css": [
        "#b_sydConvCont",
        "div[aria-label='Copilot']",
        "div[aria-label='Meta AI']",
        "a[aria-label='Grok']",
        "div[data-testid='GrokDrawer']"
      ],
      "contains": [
        { "text": "ask meta ai", "scope": "span,div[aria-label],a", "up": 2, "maxlen": 24 },
        { "text": "ask grok", "scope": "span,a,div[aria-label]", "up": 2, "maxlen": 24 }
      ]
    },
    {
      "id": "reddit-answers",
      "name": "Reddit Answers",
      "recommended": true,
      "match": ["reddit.com"],
      "css": ["a[href*='/answers']", "reddit-answers", "div[data-testid='reddit-answers']"],
      "contains": [
        { "text": "reddit answers", "scope": "a,span,[role='heading']", "up": 2, "maxlen": 24 }
      ]
    },
    {
      "id": "youtube-ai",
      "name": "YouTube AI features",
      "recommended": true,
      "match": ["youtube.com"],
      "css": [
        "ytd-ai-summary-renderer",
        "video-summary-content-view-model",
        "#video-summary",
        "#expandable-metadata:has(video-summary-content-view-model)"
      ],
      "contains": [
        { "text": "ai summary", "scope": "span,[role='heading'],button", "up": 3, "maxlen": 24 }
      ]
    },
    {
      "id": "duckduckgo-ai",
      "name": "DuckDuckGo AI (Assist and AI chat)",
      "recommended": true,
      "match": ["duckduckgo.com"],
      "redirect": [
        { "path": "/", "set": { "assist": "false", "kbe": "0" } }
      ],
      "css": [
        "[data-testid='ai-chat']",
        "a[href*='duckduckgo.com/aichat']"
      ],
      "contains": [
        { "text": "duck.ai", "scope": "a,span,[role='heading']", "up": 2, "maxlen": 24 }
      ]
    },
    {
      "id": "brave-ai",
      "name": "Brave Search AI (Answers and summary)",
      "recommended": true,
      "match": ["search.brave.com"],
      "redirect": [
        { "path": "/search", "set": { "summary": "0" } }
      ],
      "css": [
        "#summarizer",
        "[data-testid='summarizer']"
      ],
      "contains": [
        { "text": "answer with ai", "scope": "button,a,[role='heading']", "up": 2, "maxlen": 24 }
      ]
    },
    {
      "id": "qwant-ai",
      "name": "Qwant AI (overview and summarize)",
      "recommended": true,
      "match": ["qwant.com"],
      "redirect": [
        { "path": "/", "set": { "llm": "0" } }
      ],
      "css": [
        "[data-testid='summarize']"
      ],
      "contains": [
        { "text": "summarize with ai", "scope": "button,a,[role='heading']", "up": 2, "maxlen": 28 }
      ]
    },
    {
      "id": "pinterest-ai",
      "name": "Pinterest AI slop",
      "recommended": true,
      "match": ["pinterest."],
      "css": [
        "div[data-test-id='ai-generated-label']",
        "[aria-label*='AI generated']",
        "div:has(> [data-test-id='ai-generated-label'])"
      ],
      "contains": [
        { "text": "ai generated", "scope": "span,div[aria-label],[data-test-id]", "up": 5, "maxlen": 24 }
      ]
    },
    {
      "id": "amazon-ai",
      "name": "Amazon AI (Rufus and AI slop)",
      "recommended": true,
      "match": ["amazon."],
      "css": [
        "#rufus-sidebar",
        "div[data-card-metrics-id*='rufus']",
        "[aria-label*='Rufus']",
        "div[data-csa-c-content-id*='ai-generated']"
      ],
      "contains": [
        { "text": "ai-generated", "scope": "span,div[aria-label],[data-csa-c-content-id]", "up": 3, "maxlen": 28 }
      ]
    },
    {
      "id": "etsy-ai",
      "name": "Etsy AI slop",
      "recommended": true,
      "match": ["etsy."],
      "css": ["[data-ai-generated]", "div:has(> [data-ai-generated])"],
      "contains": [
        { "text": "created with ai", "scope": "span,p,div[aria-label]", "up": 4, "maxlen": 28 }
      ]
    }
  ]
}
