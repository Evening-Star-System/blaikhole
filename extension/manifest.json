{
  "manifest_version": 3,
  "name": "Blaikhole",
  "version": "0.1.0",
  "description": "A black hole for AI slop. Hide AI overviews, assistant panels, and AI-generated slop across the web.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blaikhole@eveningstar.app",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "all_frames": false,
      "js": ["src/list-data.js", "src/content.js"]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Blaikhole",
    "default_popup": "src/options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
